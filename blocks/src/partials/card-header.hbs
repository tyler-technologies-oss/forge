{{#if tab1}}
<div slot="header">
  <forge-toolbar no-divider>
    {{> card-header-content}}
  </forge-toolbar>
  <forge-tab-bar active-tab="0" clustered>
    <forge-tab id="{{tab1Id}}">{{tab1}}</forge-tab>
    {{#if tab2}}
    <forge-tab id="{{tab2Id}}">{{tab2}}</forge-tab>
    {{/if}}
    {{#if tab3}}
    <forge-tab id="{{tab3Id}}">{{tab3}}</forge-tab>
    {{/if}}
    {{#if tab4}}
    <forge-tab id="{{tab4Id}}">{{tab4}}</forge-tab>
    {{/if}}
  </forge-tab-bar>
</div>
{{else}}
<forge-toolbar slot="header">
  {{> card-header-content}}
</forge-toolbar>
{{/if}}
