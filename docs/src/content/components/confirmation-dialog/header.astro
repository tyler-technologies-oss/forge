---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader {thumbnail}>
  <forge-button variant="outlined" theme="error" data-confirmation-dialog-trigger>Delete images</forge-button>
  {
    !thumbnail && (
      <forge-confirmation-dialog>
        <span slot="title">Delete selected images?</span>
        <span slot="message">Images will be permanently removed from your account and all synced devices.</span>
        <span slot="secondary-button-text">Cancel</span>
        <span slot="primary-button-text">Delete</span>
      </forge-confirmation-dialog>
    )
  }
</ComponentHeader>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-confirmation-dialog-trigger]").forEach((button) => {
      const dialog = button.parentElement?.querySelector("forge-confirmation-dialog");
      if (!dialog) {
        return;
      }
      button.addEventListener("click", () => {
        dialog.open = true;
      });
    });
  });
</script>
