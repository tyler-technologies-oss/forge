---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader fit="cover" inset="16px" {thumbnail}>
  <forge-scaffold class="h-80">
    <div slot="header" class="h-10 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">header</div>
    <div slot="left" class="w-16 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">left</div>
    <div slot="body-header" class="h-8 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">body-header</div>
    <div slot="body-left" class="w-24 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">body-left</div>
    <div slot="body" class="box-border h-full overflow-hidden p-1">
      <div class="flex size-full items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">body</div>
    </div>
    <div slot="body-right" class="w-24 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">body-right</div>
    <div slot="body-footer" class="h-8 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">body-footer</div>
    <div slot="right" class="w-16 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">right</div>
    <div slot="footer" class="h-10 m-1 flex items-center justify-center rounded border border-dashed border-outline text-sm opacity-70">footer</div>
  </forge-scaffold>
</ComponentHeader>
