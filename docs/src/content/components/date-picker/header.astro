---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader {thumbnail}>
  <forge-date-picker class="w-64">
    <forge-text-field>
      <label for="date-picker-header-input" slot="label">Date</label>
      <input type="text" id="date-picker-header-input" value="01/15/2025" />
      <forge-icon-button aria-label="Toggle calendar" slot="end" density="medium">
        <forge-icon name="insert_invitation"></forge-icon>
      </forge-icon-button>
    </forge-text-field>
  </forge-date-picker>
</ComponentHeader>
