---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader {thumbnail}>
  <div class="w-96">
    <forge-toolbar>
      <h2 slot="start" class="text-heading3 m-0 p-0">Toolbar</h2>
      <forge-icon-button slot="end" aria-label="Search"><forge-icon name="search"></forge-icon></forge-icon-button>
      <forge-icon-button slot="end" aria-label="More"><forge-icon name="more_vert"></forge-icon></forge-icon-button>
    </forge-toolbar>
  </div>
</ComponentHeader>
