---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader {thumbnail}>
  <div class="flex items-center gap-small">
    <span>Press</span>
    <forge-kbd mod keys="K"></forge-kbd>
    <span>to search the docs</span>
  </div>
  <forge-keyboard-shortcut global key="mod+k"></forge-keyboard-shortcut>
</ComponentHeader>
