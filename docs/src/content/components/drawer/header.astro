---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader fit="cover" {thumbnail}>
  <div class="flex h-full">
    <forge-drawer open direction="left">
      <aside>
        <forge-list navlist>
          <forge-list-item selected>
            <forge-icon slot="start" name="home"></forge-icon>
            <a href="javascript: void(0);">Home</a>
          </forge-list-item>
          <forge-list-item>
            <forge-icon slot="start" name="folder"></forge-icon>
            <a href="javascript: void(0);">Projects</a>
          </forge-list-item>
          <forge-list-item>
            <forge-icon slot="start" name="settings"></forge-icon>
            <a href="javascript: void(0);">Settings</a>
          </forge-list-item>
        </forge-list>
      </aside>
    </forge-drawer>
    <div class="p-medium">Page content</div>
  </div>
</ComponentHeader>
