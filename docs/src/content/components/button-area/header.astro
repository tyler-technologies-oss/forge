---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader {thumbnail}>
  <forge-card class="p-0 w-80 max-w-full">
    <forge-button-area>
      <button slot="button" type="button" aria-labelledby="button-area-heading"></button>
      <div class="flex items-center gap-xsmall p-medium">
        <div class="me-auto">
          <div id="button-area-heading">Account settings</div>
          <div>Manage your profile</div>
        </div>
        <forge-icon name="arrow_forward"></forge-icon>
      </div>
    </forge-button-area>
  </forge-card>
</ComponentHeader>
