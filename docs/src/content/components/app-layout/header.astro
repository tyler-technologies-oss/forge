---
import ComponentHeader from "../../../components/ComponentHeader.astro";

const { thumbnail = false } = Astro.props;
---

<ComponentHeader fit="cover" zoom={0.6} interactive={false} height="320px" {thumbnail}>
  <forge-app-layout app-title="My Application" app-title-href="#">
    <forge-icon slot="app-bar-logo" name="home"></forge-icon>
    <div slot="app-bar-end" class="flex items-center gap-xsmall">
      <forge-icon-button density="medium" aria-label="Notifications" theme="app-bar">
        <forge-icon name="notifications"></forge-icon>
      </forge-icon-button>
    </div>
    <forge-list slot="navigation" navlist>
      <forge-list-item selected>
        <forge-icon slot="start" name="dashboard"></forge-icon>
        <a href="#">Dashboard</a>
      </forge-list-item>
      <forge-list-item>
        <forge-icon slot="start" name="folder"></forge-icon>
        <a href="#">Projects</a>
      </forge-list-item>
      <forge-list-item>
        <forge-icon slot="start" name="person"></forge-icon>
        <a href="#">Users</a>
      </forge-list-item>
      <forge-divider></forge-divider>
      <forge-list-item>
        <forge-icon slot="start" name="settings"></forge-icon>
        <a href="#">Settings</a>
      </forge-list-item>
      <forge-list-item>
        <forge-icon slot="start" name="help"></forge-icon>
        <a href="#">Help</a>
      </forge-list-item>
    </forge-list>
    <main slot="body" class="p-medium grid bg-surface-dim">
      <div class="striped-box"></div>
    </main>
  </forge-app-layout>
</ComponentHeader>
