---
import BaseLayout from "../layouts/BaseLayout.astro";
import notFoundImage from "../assets/images/404/not-found.svg";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist or has moved."
  searchable={false}>
  <forge-page-state class="min-h-full">
    <img src={notFoundImage.src} alt="" slot="graphic" />
    <h1
      slot="title"
      class="m-0 text-[length:inherit] font-[weight:inherit] leading-[inherit]">
      Looks like this page wandered off
    </h1>
    <p slot="message">
      The page you're looking for may have been moved or removed, or the URL may
      have been mistyped.
    </p>
    <forge-button slot="action" data-search-trigger>
      <forge-icon slot="start" name="search" aria-hidden="true"></forge-icon>
      Search the docs
    </forge-button>
    <forge-button slot="action" variant="filled">
      <a href={baseUrl}>Back to home</a>
    </forge-button>
  </forge-page-state>
</BaseLayout>
