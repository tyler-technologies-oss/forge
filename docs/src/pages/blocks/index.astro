---
/**
 * Blocks listing page - displays all blocks grouped by category.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentHeader from "../../components/ContentHeader.astro";
import PageScaffold from "../../components/PageScaffold.astro";
import {
  getBlocksGroupedByCategory,
  getBlockScreenshotUrl,
  truncateDescription,
  type GroupedBlocks,
} from "../../data/blocks";

// Individual component blocks now surface directly on each component's own
// usage page, so the listing only needs to showcase larger, multi-component patterns.
const groupedBlocks = (await getBlocksGroupedByCategory()).filter(
  (group) => group.label !== "Components",
);
const categoryOptions = groupedBlocks.map((group) => group.label);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Blocks"
  description="Pre-built UI patterns and templates"
  searchable={false}>
  <PageScaffold class="blocks-page">
    <div slot="header">
    <ContentHeader
      title="Blocks"
      description="Pre-built UI patterns and layouts to accelerate development."
    />
    <div class="mb-medium flex flex-col gap-medium">
        <div class="flex items-center gap-medium">
          <forge-text-field class="block grow" show-clear>
          <forge-icon slot="start" name="search"></forge-icon>
          <forge-icon-button slot="clear-button" tabindex="-1" dense aria-label="Clear">
            <forge-icon name="clear"></forge-icon>
          </forge-icon-button>
          <input type="text" id="block-filter" autocomplete="off" placeholder="Search blocks" aria-label="Search blocks" />
        </forge-text-field>
          <forge-button-toggle-group id="view-toggle" value="card" mandatory aria-label="Layout">
            <forge-button-toggle value="card" aria-label="Card view">
              <forge-icon name="view_grid"></forge-icon>
            </forge-button-toggle>
            <forge-button-toggle value="list" aria-label="List view">
              <forge-icon name="view_list"></forge-icon>
            </forge-button-toggle>
          </forge-button-toggle-group>
        </div>
        <forge-chip-set id="category-filter" type="filter" dense>
          {
            categoryOptions.map((label) => (
              <forge-chip value={label}>{label}</forge-chip>
            ))
          }
        </forge-chip-set>
      </div>
    </div>

    <div class="pt-medium">


      {
        groupedBlocks.length === 0 ? (
          <div class="flex flex-col items-center justify-center p-xxlarge bg-surface-container-low rounded-lg text-center text-low">
            <forge-icon
              name="widgets"
              external
              class="text-[48px] mb-medium opacity-50"
            />
            <p class="m-0">
              Blocks are currently being loaded. Please check back soon.
            </p>
          </div>
        ) : (
          <div id="blocks-container">
            {groupedBlocks.map((group) => (
              <section
                class="category-section mb-xxlarge"
                data-category={group.label}>
                <h2 class="text-heading4 mt-0 mb-large">{group.label}</h2>
                <div data-view="card" class="block-grid group grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] data-[view=list]:grid-cols-1 gap-large">
                  {group.items.map((block) => (
                    <div
                      class="block-card"
                      data-name={block.name.toLowerCase()}
                      data-tags={block.tags.join(" ").toLowerCase()}>
                      <forge-card class="h-full">
                        <forge-button-area class="h-full">
                          <a
                            slot="button"
                            href={`${baseUrl}blocks/${block.id}/`}
                            aria-label={`View ${block.name} block`}
                          />
                          <div class="flex h-full flex-col group-data-[view=list]:flex-row">
                          <div class="block-preview aspect-video w-full overflow-hidden group-data-[view=list]:w-[240px] group-data-[view=list]:shrink-0">
                            <img
                              src={getBlockScreenshotUrl(block)}
                              alt={`Preview of ${block.name}`}
                              loading="lazy"
                              class="w-full h-full object-cover object-top"
                            />
                          </div>
                          <div class="p-medium group-data-[view=list]:flex group-data-[view=list]:flex-col group-data-[view=list]:justify-center">
                            <h3 class="text-heading3 mt-0 mb-xsmall">
                              {block.name}
                            </h3>
                            <p class="text-medium mt-0 mb-medium">
                              <span class="group-data-[view=list]:hidden">
                                {truncateDescription(block.description)}
                              </span>
                              <span class="hidden group-data-[view=list]:inline">
                                {block.description}
                              </span>
                            </p>
                          </div>
                          </div>
                        </forge-button-area>
                      </forge-card>
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )
      }
    </div>
  </PageScaffold>
</BaseLayout>

<script>
  import {
    getListFilters,
    getListView,
    setListFilters,
    setListView,
    type ListView,
  } from "../../scripts/list-view";

  const PAGE_KEY = "blocks";

  type ChipElement = HTMLElement & { selected: boolean; value: string };

  const initBlockFilter = async (): Promise<void> => {
    const filterInput = document.getElementById("block-filter") as HTMLInputElement | null;
    const categoryChips = document.getElementById("category-filter");
    const toggle = document.getElementById("view-toggle") as (HTMLElement & { value: string }) | null;
    if (!filterInput || !categoryChips || !toggle) {
      return;
    }

    await customElements.whenDefined("forge-chip");
    const chips = Array.from(categoryChips.querySelectorAll<ChipElement>("forge-chip"));

    const applyFilters = (): void => {
      const query = filterInput.value.toLowerCase().trim();
      const selected = chips.filter((chip) => chip.selected).map((chip) => chip.value);

      document.querySelectorAll<HTMLElement>(".block-card").forEach((item) => {
        const name = item.dataset.name ?? "";
        const tags = item.dataset.tags ?? "";
        const matches = !query || name.includes(query) || tags.includes(query);
        item.style.display = matches ? "" : "none";
      });

      document.querySelectorAll<HTMLElement>(".category-section").forEach((section) => {
        const matchesCategory = selected.length === 0 || selected.includes(section.dataset.category ?? "");
        const hasVisible = Array.from(section.querySelectorAll<HTMLElement>(".block-card")).some(
          (card) => card.style.display !== "none",
        );
        section.style.display = matchesCategory && hasVisible ? "" : "none";
      });

      setListFilters(PAGE_KEY, { query: filterInput.value, categories: selected });
    };

    const applyView = (view: ListView): void => {
      document.querySelectorAll<HTMLElement>(".block-grid").forEach((el) => {
        el.dataset.view = view;
      });
    };

    const saved = getListFilters(PAGE_KEY);
    filterInput.value = saved.query;
    chips.forEach((chip) => {
      chip.selected = saved.categories.includes(chip.value);
    });
    const view = getListView();
    toggle.value = view;
    applyView(view);
    applyFilters();

    toggle.addEventListener("forge-button-toggle-group-change", ({ detail }: Event & { detail?: string }) => {
      const next: ListView = detail === "list" ? "list" : "card";
      setListView(next);
      applyView(next);
    });
    filterInput.addEventListener("input", applyFilters);
    filterInput.closest("forge-text-field")?.addEventListener("forge-text-field-clear", applyFilters);
    categoryChips.addEventListener("forge-chip-select", applyFilters);
  };

  document.addEventListener("astro:page-load", initBlockFilter);
</script>

<style is:global>
  /* Forge component CSS variables (custom properties on <forge-card> and
     <forge-button-area>) — not representable as Tailwind utilities.
     `.blocks-page` now lives on PageScaffold's root element, outside this
     file's scoped-style attribute, so this must be global to still match. */
  .blocks-page {
    --card-radius: 12px;
  }

  .blocks-page forge-button-area {
    --forge-button-area-shape: var(--card-radius);
  }

  .block-card forge-card {
    --forge-card-overflow: hidden;
    --forge-card-padding: 0;
    --forge-card-shape: var(--card-radius);
  }

  /* Top-corner radius on the block preview image matches the card radius. */
  .block-preview img {
    border-radius: var(--card-radius) var(--card-radius) 0 0;
  }

  [data-view="list"] .block-preview img {
    border-radius: var(--card-radius) 0 0 var(--card-radius);
  }
</style>
