---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageScaffold from '../../components/PageScaffold.astro';
import { categories, sourceLabels, type Category, type Source } from '../../data/components';
import { getCollection } from 'astro:content';

const components = await getCollection('components');

// Group by category
const groupedByCategory = Object.keys(categories).reduce((acc, key) => {
  acc[key as Category] = components.filter(c => c.data.category === key);
  return acc;
}, {} as Record<Category, typeof components>);
---

<BaseLayout title="Components">

  <PageScaffold>
    <div slot="header" class="max-w-[1000px]">
      <h1 class="text-heading5 mt-0 mb-xsmall">Components</h1>
      <p class="text-body3 text-medium mt-0 mb-large">
        Explore Forge's library of reusable UI components. Each component is designed to be accessible,
        customizable, and consistent with the Forge design system.
      </p>
    </div>

    <div class="max-w-[1000px]">
    {Object.entries(groupedByCategory).map(([key, categoryComponents]) => (
      categoryComponents.length > 0 && (
        <section class="mb-large">
          <h2 class="text-heading4 mt-0 mb-small pb-xsmall border-b border-outline-low">{categories[key as Category]}</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-small">
            {categoryComponents.map((component) => (
              <a href={`${import.meta.env.BASE_URL}components/${component.id}/overview/`} class="component-card block no-underline text-inherit">
                <forge-card class="h-full transition-shadow duration-short-4 ease-standard hover:shadow-4">
                  <div class="p-small">
                    <h3 class="text-heading3 mt-0 mb-xxsmall">{component.data.title}</h3>
                    <p class="text-medium mt-0 mb-xsmall line-clamp-2">{component.data.description}</p>
                    <forge-badge theme={component.data.source === 'core' ? 'info-secondary' : 'success'}>
                      {sourceLabels[component.data.source as Source]}
                    </forge-badge>
                  </div>
                </forge-card>
              </a>
            ))}
          </div>
        </section>
      )
    ))}

    {components.length === 0 && (
      <div class="text-center p-xlarge bg-surface-container rounded-lg">
        <p class="text-medium m-0">No components documented yet. Add MDX files to <code class="bg-surface-container-high rounded-sm px-xsmall py-xxsmall">src/content/components/</code>.</p>
      </div>
    )}
    </div>
  </PageScaffold>
</BaseLayout>

<style>
  /* hover:shadow-4 doesn't propagate to a child forge-card via Tailwind's peer/group,
     so keep the parent-hover targeting rule in CSS. */
  .component-card:hover forge-card {
    box-shadow: var(--forge-elevation-4);
  }
</style>
