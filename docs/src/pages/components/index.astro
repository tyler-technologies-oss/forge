---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageScaffold from '../../components/PageScaffold.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import { categories, type Category } from '../../data/components';
import { categoryIcons } from '../../data/component-categories';
import { getCollection } from 'astro:content';

const components = await getCollection('components');

// Group by category
const groupedByCategory = Object.keys(categories).reduce((acc, key) => {
  acc[key as Category] = components.filter(c => c.data.category === key);
  return acc;
}, {} as Record<Category, typeof components>);
---

<BaseLayout title="Components">

  <PageScaffold>
    <ContentHeader
      slot="header"
      title="Components"
      description="Explore Forge's library of reusable UI components. Each component is designed to be accessible, customizable, and consistent with the Forge design system."
    />

    <div class="max-w-[1000px] mt-large">
    {Object.entries(groupedByCategory).map(([key, categoryComponents]) => (
      categoryComponents.length > 0 && (
        <section class="mb-large">
          <h2 class="text-heading3 mt-0 mb-xxsmall pb-xsmall">{categories[key as Category]}</h2>
          <forge-divider class="mb-large"></forge-divider>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-small">
            {categoryComponents.map((component) => (
              <forge-card class="h-full [--forge-card-padding:0]">
                <forge-button-area>
                  <a
                    slot="button"
                    href={`${import.meta.env.BASE_URL}components/${component.id}/usage/`}
                    aria-labelledby={`${component.id}-heading`}></a>
                  <div class="flex items-center gap-medium p-medium">
                    <forge-avatar
                      class="shrink-0 [--forge-avatar-background:var(--forge-theme-primary-container-low)] [--forge-avatar-color:var(--forge-theme-on-primary-container-low)] [--forge-avatar-shape:var(--forge-shape-medium)]"
                      size="large">
                      <forge-icon name={categoryIcons[key as Category]}></forge-icon>
                    </forge-avatar>
                    <div class="flex flex-col gap-xxxsmall min-w-0">
                      <span id={`${component.id}-heading`} class="text-heading1">{component.data.title}</span>
                      <span class="text-label2 text-on-surface-secondary line-clamp-2">{component.data.description}</span>
                      <forge-tooltip>{component.data.description}</forge-tooltip>
                    </div>
                  </div>
                </forge-button-area>
              </forge-card>
            ))}
          </div>
        </section>
      )
    ))}

    {components.length === 0 && (
      <div class="text-center p-xlarge bg-surface-container rounded-lg">
        <p class="text-medium m-0">No components documented yet. Add MDX files to <code class="bg-surface-container-high rounded-sm px-xsmall py-xxsmall">src/content/components/</code>.</p>
      </div>
    )}
    </div>
  </PageScaffold>
</BaseLayout>

