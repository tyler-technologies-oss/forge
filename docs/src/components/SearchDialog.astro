---
/**
 * SearchDialog - Site search, backed by the Pagefind index that `pnpm build`
 * writes to `dist/pagefind/`. Rendered once by BaseLayout and persisted across
 * SPA navigation. It opens from any SearchField trigger or Cmd/Ctrl+K. The
 * index doesn't exist under `astro dev`, so the dialog reports that search
 * needs a build there.
 */
import { buildNavigation } from "../config/navigation";

const sectionIcons = Object.fromEntries(
  buildNavigation()
    .flatMap(({ items }) => items)
    .filter(({ icon }) => icon)
    .map(({ label, icon }) => [label, icon]),
);
---

<div class="contents" transition:persist="search-dialog">
  <forge-keyboard-shortcut key="meta+k" global allow-while-typing data-search-shortcut></forge-keyboard-shortcut>
  <forge-keyboard-shortcut key="ctrl+k" global allow-while-typing data-search-shortcut></forge-keyboard-shortcut>

  <forge-dialog
    label="Search the docs"
    class="[--forge-dialog-width:640px] [--forge-dialog-max-width:calc(100vw-32px)] [--forge-dialog-height:60vh] [--forge-dialog-shape:var(--forge-shape-extra-large)]"
    data-search-dialog
    data-section-icons={JSON.stringify(sectionIcons)}>
    <forge-scaffold>
      <div slot="header" class="border-b border-outline">
        <forge-text-field label-position="none" variant="plain" density="extra-large" class="w-full [--forge-field-padding-inline-start:var(--forge-spacing-medium)] [[data-search-dialog]:not([fullscreen])_&]:[--forge-focus-indicator-shape-start-start:var(--forge-shape-extra-large)] [[data-search-dialog]:not([fullscreen])_&]:[--forge-focus-indicator-shape-start-end:var(--forge-shape-extra-large)] [[data-search-dialog]:not([fullscreen])_&]:[--forge-focus-indicator-shape-end-start:0px] [[data-search-dialog]:not([fullscreen])_&]:[--forge-focus-indicator-shape-end-end:0px]">
          <forge-icon slot="start" name="search"></forge-icon>
          <input
            type="text"
            placeholder="Search"
            aria-label="Search the docs"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="search-results"
            autocomplete="off"
            data-search-input
          />
          <div slot="end" class="flex items-center">
            <forge-button
              variant="text"
              dense
              hidden
              class="[--forge-focus-indicator-shape-start-start:initial] [--forge-focus-indicator-shape-start-end:initial] [--forge-focus-indicator-shape-end-start:initial] [--forge-focus-indicator-shape-end-end:initial]"
              data-search-clear>Clear the query</forge-button>
            <forge-divider vertical class="h-4 px-[4px]" data-search-clear-divider hidden></forge-divider>
            <div class="flex pr-[4px]">
              <forge-icon-button aria-label="Close search" class="[--forge-focus-indicator-shape-start-start:initial] [--forge-focus-indicator-shape-start-end:initial] [--forge-focus-indicator-shape-end-start:initial] [--forge-focus-indicator-shape-end-end:initial]" data-search-close>
                <forge-icon name="close"></forge-icon>
              </forge-icon-button>
            </div>
          </div>
        </forge-text-field>
      </div>

      <div slot="body" class="p-medium">
        <div
          id="search-results"
          class="flex flex-col gap-medium [--forge-list-item-shape:var(--forge-shape-large)] [&_mark]:bg-transparent [&_mark]:text-primary [&_mark]:font-bold"
          data-search-results>
        </div>
        <p class="text-medium text-center m-0 py-xlarge" data-search-status>Type to search the docs.</p>
        <p class="sr-only" aria-live="polite" data-search-announcer></p>
      </div>

      <forge-toolbar no-border slot="footer" inverted class="[--forge-theme-surface:var(--forge-theme-surface-dim)]">
        <div slot="start" class="flex items-center gap-large text-label2 text-medium">
          <span class="flex items-center gap-xsmall">
            <forge-kbd keys="↓ ↑" dense></forge-kbd>
            Navigate
          </span>
          <span class="flex items-center gap-xsmall">
            <forge-kbd keys="Enter" dense></forge-kbd>
            Select
          </span>
          <span class="flex items-center gap-xsmall">
            <forge-kbd keys="Esc" dense></forge-kbd>
            Close
          </span>
        </div>
      </forge-toolbar>
    </forge-scaffold>
  </forge-dialog>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import type { DialogComponent } from "@tylertech/forge/dialog";
  import type { IListItemComponent } from "@tylertech/forge/list";

  interface PagefindPage {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
  }

  interface PagefindResult {
    data(): Promise<PagefindPage>;
  }

  interface Pagefind {
    options(options: Record<string, unknown>): Promise<void>;
    debouncedSearch(term: string, options?: object, timeout?: number): Promise<{ results: PagefindResult[] } | null>;
  }

  interface SearchHit {
    title: string;
    url: string;
    excerpt: string;
    icon: string;
  }

  const MAX_RESULTS = 10;
  const CANDIDATE_LIMIT = 30;
  const FALLBACK_ICON = "file_document";
  const EXCERPT_LENGTH = 18;
  const DEBOUNCE_MS = 150;
  const DEFAULT_SECTION = "Docs";
  const PAGEFIND_URL = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
  const TRIGGER_SELECTOR = "[data-search-trigger]";

  const STATUS = {
    idle: "Type to search the docs.",
    unavailable: "Search is available once the site is built.",
    noResults: (query: string) => `No results for "${query}".`,
  };

  const dialog = document.querySelector<DialogComponent>("[data-search-dialog]");
  const sectionIcons: Record<string, string> = JSON.parse(dialog?.dataset.sectionIcons ?? "{}");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const clearButton = document.querySelector<HTMLElement>("[data-search-clear]");
  const clearDivider = document.querySelector<HTMLElement>("[data-search-clear-divider]");
  const resultsContainer = document.querySelector<HTMLElement>("[data-search-results]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const announcer = document.querySelector<HTMLElement>("[data-search-announcer]");

  let pagefindLoader: Promise<Pagefind | undefined> | undefined;
  let items: IListItemComponent[] = [];
  let hits: SearchHit[] = [];
  let activeIndex = -1;

  const importPagefind = async (): Promise<Pagefind | undefined> => {
    try {
      const pagefind: Pagefind = await import(/* @vite-ignore */ PAGEFIND_URL);
      await pagefind.options({ excerptLength: EXCERPT_LENGTH });
      return pagefind;
    } catch {
      return undefined;
    }
  };

  const loadPagefind = (): Promise<Pagefind | undefined> => {
    pagefindLoader ??= importPagefind();
    return pagefindLoader;
  };

  const COMPONENT_TAB_PATTERN = /^(.*\/components\/[^/]+)\/(?:usage|api|accessibility|playground)\/?$/;
  const COMPONENT_TAB_TITLE_PATTERN = / - (?:Usage|API|Accessibility|Playground)$/;

  /** Always links to the page level, never a heading anchor or a component tab other than usage. */
  const toHit = (page: PagefindPage): SearchHit => {
    const withoutHash = page.url.split("#")[0].replace(COMPONENT_TAB_PATTERN, "$1/usage");
    const pageUrl = withoutHash.endsWith("/") ? withoutHash : `${withoutHash}/`;
    const title = (page.meta.title ?? page.url).replace(COMPONENT_TAB_TITLE_PATTERN, "");
    const icon = sectionIcons[page.meta.section ?? DEFAULT_SECTION] ?? FALLBACK_ICON;
    return { title, url: pageUrl, excerpt: page.excerpt, icon };
  };

  const dedupeHits = (hits: SearchHit[]): SearchHit[] => {
    const seen = new Set<string>();
    return hits.filter(({ url }) => {
      if (seen.has(url)) {
        return false;
      }
      seen.add(url);
      return true;
    });
  };

  const titleRank = (title: string, query: string): number => {
    const normalizedTitle = title.toLowerCase();
    const normalizedQuery = query.toLowerCase();
    if (normalizedTitle === normalizedQuery) {
      return 0;
    }
    if (normalizedTitle.startsWith(normalizedQuery)) {
      return 1;
    }
    return normalizedTitle.includes(normalizedQuery) ? 2 : 3;
  };

  /** Title matches come first (exact, then prefix, then contains); Pagefind's relevance order breaks ties. */
  const rankHits = (hits: SearchHit[], query: string): SearchHit[] =>
    hits
      .map((hit, order) => ({ hit, order, rank: titleRank(hit.title, query) }))
      .sort((a, b) => a.rank - b.rank || a.order - b.order)
      .map(({ hit }) => hit);

  const showStatus = (message: string | null): void => {
    if (!status) {
      return;
    }
    status.hidden = message === null;
    status.textContent = message ?? "";
  };

  const setActive = (index: number): void => {
    activeIndex = index;
    items.forEach((item, itemIndex) => {
      item.active = itemIndex === index;
    });

    const activeItem = items[index];
    if (!activeItem) {
      input?.removeAttribute("aria-activedescendant");
      return;
    }
    input?.setAttribute("aria-activedescendant", activeItem.querySelector("a")?.id ?? "");
    activeItem.scrollIntoView({ block: "nearest" });
  };

  /** Pagefind excerpts are HTML-escaped, with matches wrapped in `<mark>`, so they're safe as markup. */
  const createResultItem = (hit: SearchHit, index: number): IListItemComponent => {
    const item = document.createElement("forge-list-item");
    item.twoLine = true;

    const icon = document.createElement("forge-icon");
    icon.slot = "start";
    icon.name = hit.icon;

    const link = document.createElement("a");
    link.id = `search-result-${index}`;
    link.href = hit.url;
    link.textContent = hit.title;

    const excerpt = document.createElement("span");
    excerpt.slot = "secondary-text";
    excerpt.innerHTML = hit.excerpt;

    item.append(icon, link, excerpt);
    return item;
  };

  const renderResults = (): void => {
    if (!resultsContainer) {
      return;
    }

    const list = document.createElement("forge-list");
    list.setAttribute("aria-label", "Search results");
    list.append(...hits.map(createResultItem));

    resultsContainer.replaceChildren(...(hits.length ? [list] : []));
    items = [...resultsContainer.querySelectorAll("forge-list-item")];
    input?.setAttribute("aria-expanded", String(items.length > 0));
    const renderedItems = items;
    setActive(items.length ? 0 : -1);
    // The list items render their focus indicator after connecting, and setting `active` to its current value
    // is a no-op, so clear it and apply it again once they have.
    requestAnimationFrame(() => {
      if (renderedItems === items && activeIndex === 0) {
        items[0].active = false;
        setActive(0);
      }
    });
  };

  const clearResults = (message: string | null): void => {
    hits = [];
    renderResults();
    showStatus(message);
  };

  const runSearch = async (): Promise<void> => {
    const query = input?.value.trim() ?? "";
    const isEmpty = !input?.value;
    if (clearButton && clearDivider) {
      clearButton.hidden = isEmpty;
      clearDivider.hidden = isEmpty;
    }
    if (!query) {
      clearResults(STATUS.idle);
      return;
    }

    const pagefind = await loadPagefind();
    if (!pagefind) {
      clearResults(STATUS.unavailable);
      return;
    }

    const search = await pagefind.debouncedSearch(query, {}, DEBOUNCE_MS);
    if (!search) {
      return;
    }

    const pages = await Promise.all(search.results.slice(0, CANDIDATE_LIMIT).map((result) => result.data()));
    if (query !== input?.value.trim()) {
      return;
    }

    hits = rankHits(dedupeHits(pages.map(toHit)), query).slice(0, MAX_RESULTS);
    renderResults();
    showStatus(hits.length ? null : STATUS.noResults(query));
    if (announcer) {
      announcer.textContent = `${search.results.length} results`;
    }
  };

  const openSearch = (initialQuery?: string): void => {
    if (!dialog || !input) {
      return;
    }
    if (initialQuery !== undefined) {
      input.value = initialQuery;
      runSearch();
    }
    dialog.open = true;
    loadPagefind();
  };

  const closeSearch = (): void => {
    if (dialog) {
      dialog.open = false;
    }
  };

  /**
   * The animated close finishes asynchronously and force-closes the native dialog when it does. If a
   * navigation swaps the persisted dialog in the meantime, that late close hits the next time it opens.
   */
  const closeSearchImmediately = (): void => {
    if (!dialog) {
      return;
    }
    const { animationType } = dialog;
    dialog.animationType = "none";
    dialog.open = false;
    dialog.animationType = animationType;
  };

  const goTo = (url: string): void => {
    closeSearchImmediately();
    navigate(url);
  };

  const onInputKeydown = (event: KeyboardEvent): void => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      if (!items.length) {
        return;
      }
      if (activeIndex === -1) {
        setActive(event.key === "ArrowDown" ? 0 : items.length - 1);
        return;
      }
      const step = event.key === "ArrowDown" ? 1 : -1;
      setActive((activeIndex + step + items.length) % items.length);
      return;
    }

    if (event.key === "Enter" && !event.repeat && !event.isComposing && hits[activeIndex]) {
      event.preventDefault();
      goTo(hits[activeIndex].url);
    }
  };

  /** Typing a character into the read-only trigger field opens the dialog with it as the query. */
  const onTriggerKeydown = (event: KeyboardEvent): void => {
    const isCharacter = event.key.length === 1 && !event.metaKey && !event.ctrlKey && !event.altKey;
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      openSearch();
    } else if (isCharacter) {
      event.preventDefault();
      openSearch(event.key);
    }
  };

  // This script re-runs on SPA navigation while the dialog and its shortcuts persist,
  // so bind once or every Cmd/Ctrl+K press would toggle the dialog repeatedly.
  if (dialog && !dialog.dataset.searchBound) {
    dialog.dataset.searchBound = "true";

    document.addEventListener("astro:before-swap", closeSearchImmediately);
    document.addEventListener("astro:after-swap", closeSearchImmediately);

    // Triggers live in swapped page content (the mobile header) as well as the
    // persisted sidenav, so listen on the document rather than binding each one.
    document.addEventListener("click", (event) => {
      if ((event.target as Element).closest(TRIGGER_SELECTOR)) {
        openSearch();
      }
    });

    document.addEventListener("keydown", (event) => {
      const { target } = event;
      if (target instanceof HTMLInputElement && target.closest(TRIGGER_SELECTOR)) {
        onTriggerKeydown(event);
      }
    });

    document.querySelectorAll("[data-search-shortcut]").forEach((shortcut) => {
      shortcut.addEventListener("forge-keyboard-shortcut-activate", () => (dialog?.open ? closeSearch() : openSearch()));
    });

    input?.addEventListener("input", runSearch);
    input?.addEventListener("keydown", onInputKeydown);
    clearButton?.addEventListener("click", () => {
      if (!input) {
        return;
      }
      input.value = "";
      runSearch();
      input.focus();
    });

    dialog?.addEventListener("forge-dialog-open", () => input?.select());
    document.querySelector("[data-search-close]")?.addEventListener("click", closeSearch);

    resultsContainer?.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) {
        closeSearchImmediately();
      }
    });
  }
</script>
