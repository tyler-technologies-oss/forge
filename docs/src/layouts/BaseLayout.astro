---
import { ClientRouter } from "astro:transitions";
import FoundryChatbot from "../components/FoundryChatbot.astro";
import PendoAnalytics from "../components/PendoAnalytics.astro";
import SearchDialog from "../components/SearchDialog.astro";
import SearchField from "../components/SearchField.astro";
import Sidenav from "../components/Sidenav.astro";
import { getCollection } from "astro:content";
import "../styles/global.css";
import "../styles/dark-theme.scss";

interface Props {
  title: string;
  description?: string;
  /**
   * Drops the 960px content cap for pages that need the full body width
   * (icon library, blocks gallery, etc). These pages don't render a TOC.
   */
  wide?: boolean;
  /**
   * Removes the body card's padding so content (like the homepage hero) runs
   * edge to edge.
   */
  flush?: boolean;
  /**
   * Includes the page in the Pagefind search index. Pages that never call
   * BaseLayout (like redirect stubs) are left out automatically.
   */
  searchable?: boolean;
}

const {
  title,
  description = "Forge Design System Documentation",
  wide = false,
  flush = false,
  searchable = true,
} = Astro.props;

const SEARCH_SECTIONS: Record<string, string> = {
  about: "About",
  components: "Components",
  designing: "Designing",
  developing: "Developing",
  faq: "FAQ",
  icons: "Icons",
  tokens: "Tokens",
};

const searchSection = SEARCH_SECTIONS[Astro.url.pathname.split("/")[1]] ?? "Docs";

const components = await getCollection("components");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Forge Design System</title>
    <ClientRouter />

    <!-- Forge font -->
    <link
      rel="stylesheet"
      href="https://cdn.forge.tylertech.com/v1/css/tyler-font.css"
    />

    <!-- Forge styles -->
    <link
      rel="stylesheet"
      href="https://cdn.forge.tylertech.com/v3/css/forge-core.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.forge.tylertech.com/v1/libs/@tylertech/forge@3.14.0/forge.css"
    />

    <!-- Theme initialization (prevent flash) -->
    <script is:inline>
      (function () {
        const legacy = localStorage.getItem("forge-docs-theme");
        if (legacy) {
          localStorage.setItem(".forge-theme", legacy);
          localStorage.removeItem("forge-docs-theme");
        }
        const stored = localStorage.getItem(".forge-theme");
        const system = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        const theme = stored === "light" || stored === "dark" ? stored : system;
        document.documentElement.setAttribute("data-forge-theme", theme);
      })();
    </script>

    <PendoAnalytics />

    <!-- Register Forge components on client -->
    <script>
      import "../scripts/forge-components";
      import { initTheme } from "../scripts/theme";
      initTheme();

      // Fade the body in once forge-scaffold/forge-card are upgraded, so we
      // never flash unstyled/undefined custom elements. `customElements.get`
      // is synchronous, so on SPA navigations (where both are already
      // defined) this resolves before paint with no visible fade.
      function markReadyWhenForgeDefined() {
        if (customElements.get("forge-scaffold") && customElements.get("forge-card")) {
          document.body.classList.add("ready");
          return;
        }

        Promise.all([
          customElements.whenDefined("forge-scaffold"),
          customElements.whenDefined("forge-card"),
        ]).then(() => document.body.classList.add("ready"));
      }

      markReadyWhenForgeDefined();
      document.addEventListener("astro:after-swap", markReadyWhenForgeDefined);
    </script>

    <!-- Update sidenav state on SPA navigation -->
    <script>
      import type { DialogComponent } from "@tylertech/forge/dialog";

      const navQuery = window.matchMedia("(min-width: 60rem)");

      function getSidenav() {
        return document.querySelector<HTMLElement>("[data-sidenav]");
      }

      function getNavDialog() {
        return document.querySelector<DialogComponent>("[data-nav-dialog]");
      }

      // Below the `nav` breakpoint the persisted sidenav moves into the menu
      // dialog, so there's only ever one copy of it (and of its ids and
      // scripts). On SPA navigation Astro puts it back in the scaffold, so
      // this runs again on every page load.
      function placeSidenav() {
        const sidenav = getSidenav();
        const scaffold = document.querySelector("[data-app-scaffold]");
        const dialogBody = document.querySelector("[data-nav-dialog-body]");
        if (!sidenav || !scaffold || !dialogBody) return;

        if (navQuery.matches) {
          const dialog = getNavDialog();
          if (dialog) dialog.open = false;
          sidenav.slot = "left";
          delete sidenav.dataset.placement;
          if (sidenav.parentElement !== scaffold) scaffold.prepend(sidenav);
          return;
        }

        sidenav.removeAttribute("slot");
        sidenav.dataset.placement = "dialog";
        if (sidenav.parentElement !== dialogBody) dialogBody.append(sidenav);
      }

      function bindNavMenu() {
        const dialog = getNavDialog();
        if (!dialog) return;

        const setOpen = (open: boolean) => {
          dialog.open = open;
        };

        document.querySelector("[data-nav-open]")?.addEventListener("click", () => setOpen(true));
        document.querySelector("[data-nav-close]")?.addEventListener("click", () => setOpen(false));
        dialog.addEventListener("click", (event) => {
          if ((event.target as Element).closest("a[href]")) setOpen(false);
        });
      }

      function getSidenavScrollEl() {
        return getSidenav()?.querySelector('[slot="body"]') ?? null;
      }

      // rebindExpansionPanels() below forces a reflow of the sidenav body
      // (it has to, to fix stale trigger references), which resets its
      // scrollTop on every SPA navigation. Save it before the swap and
      // reapply it after that reflow has happened.
      let sidenavScrollTop = 0;

      document.addEventListener("astro:before-swap", () => {
        const el = getSidenavScrollEl();
        if (el) sidenavScrollTop = el.scrollTop;
      });

      function updateNavSelection() {
        const sidenav = getSidenav();
        if (!sidenav) return;

        const currentPath = window.location.pathname;
        const navItems = sidenav.querySelectorAll("forge-list-item");

        navItems.forEach((item) => {
          const hasExpansionPanel = item.querySelector("forge-expansion-panel");
          if (hasExpansionPanel) {
            item.removeAttribute("selected");
            return;
          }

          const link = item.querySelector("a");
          if (!link) return;
          const href = link.getAttribute("href");
          if (!href) return;

          const isRootPath =
            href === "/" ||
            (href.endsWith("/") && href.split("/").filter(Boolean).length <= 1);
          const isSelected = isRootPath
            ? currentPath === href
            : currentPath.startsWith(href);
          item.toggleAttribute("selected", isSelected);
        });
      }

      // The persisted sidenav gets moved in the DOM on SPA navigation, which
      // breaks forge-expansion-panel's cached trigger reference. Re-set the
      // `trigger` / `open-icon` attributes so the component re-resolves them.
      function rebindExpansionPanels() {
        const sidenav = getSidenav();
        if (!sidenav) return;

        const currentPath = window.location.pathname;
        const panels = sidenav.querySelectorAll("forge-expansion-panel");

        panels.forEach((panel) => {
          const triggerId = panel.getAttribute("trigger");
          const openIconId = panel.getAttribute("open-icon");
          const hasActiveChild = Array.from(
            panel.querySelectorAll("a[href]"),
          ).some((link) => {
            const href = link.getAttribute("href");
            return !!href && currentPath.startsWith(href);
          });

          if (triggerId) panel.removeAttribute("trigger");
          if (openIconId) panel.removeAttribute("open-icon");

          requestAnimationFrame(() => {
            if (triggerId) panel.setAttribute("trigger", triggerId);
            if (openIconId) panel.setAttribute("open-icon", openIconId);
            if (hasActiveChild) panel.setAttribute("open", "");
          });
        });
      }

      // Cmd/Ctrl+K still works while the menu is open, so close the menu
      // rather than stacking search on top of it. The search dialog is
      // persisted, so this only needs binding once.
      document.querySelector("[data-search-dialog]")?.addEventListener("forge-dialog-open", () => {
        const dialog = getNavDialog();
        if (dialog) dialog.open = false;
      });

      navQuery.addEventListener("change", () => {
        placeSidenav();
        rebindExpansionPanels();
      });

      document.addEventListener("astro:page-load", () => {
        placeSidenav();
        bindNavMenu();
        updateNavSelection();
        rebindExpansionPanels();

        // Registered after rebindExpansionPanels' own rAF, so this runs
        // once that reflow is done and the scrollTop reset has occurred.
        requestAnimationFrame(() => {
          const el = getSidenavScrollEl();
          if (el) el.scrollTop = sidenavScrollTop;
        });
      });
    </script>
  </head>
  <body
    class="gradient-bg m-0 h-svh overflow-hidden text-high forge-typography opacity-0 transition-opacity duration-short-4 ease-standard [&.ready]:opacity-100">
    <forge-scaffold data-app-scaffold>
      <forge-toolbar
        slot="header"
        no-divider
        class="nav:hidden [--forge-toolbar-background:transparent]">
        <a
          slot="start"
          href={import.meta.env.BASE_URL}
          aria-label="Forge Design System home"
          class="flex h-full">
          <img
            src="https://forge.tylerdev.io/forge/v3/forge-logo-full-color.svg"
            alt=""
            class="block h-full max-w-[150px] dark:hidden"
          />
          <img
            src="https://forge.tylerdev.io/forge/v3/forge-logo-full-white.svg"
            alt=""
            class="hidden h-full max-w-[150px] dark:block"
          />
        </a>
        <div slot="end" class="flex items-center gap-xxsmall">
          <SearchField variant="icon-button" />
          <forge-icon-button
            aria-label="Open navigation"
            aria-haspopup="dialog"
            data-nav-open>
            <forge-icon name="menu"></forge-icon>
          </forge-icon-button>
        </div>
      </forge-toolbar>

      <div
        class="w-[250px] p-medium overflow-hidden max-nav:[&[slot=left]]:hidden data-[placement=dialog]:size-full data-[placement=dialog]:box-border data-[placement=dialog]:px-large data-[placement=dialog]:pt-0"
        slot="left"
        data-sidenav
        transition:persist>
        <Sidenav components={components} />
      </div>

      <main
        class="p-small max-nav:px-0 max-nav:pt-0 nav:ps-0 overflow-hidden flex gap-medium items-start"
        slot="body"
        data-pagefind-meta={`section:${searchSection}`}>
        <forge-card
          class:list={["body-card h-full min-w-0 flex-1", wide ? "max-w-wide" : "max-w-content", { flush }]}>
          <div class="h-full">
            <forge-scaffold>
              <div
                slot="body"
                data-scroll-body
                data-flush={flush || undefined}
                data-pagefind-body={searchable || undefined}
                data-pagefind-meta={`title:${title}`}>
                <slot />
              </div>
            </forge-scaffold>
          </div>
        </forge-card>

        {Astro.slots.has("aside") && (
          <aside class="hidden xl:block flex-shrink-0 pt-large">
            <slot name="aside" />
          </aside>
        )}
      </main>
    </forge-scaffold>

    <forge-dialog
      preset="right-sheet"
      fullscreen-threshold="0"
      label="Site navigation"
      class="[--forge-dialog-width:100%] [--forge-dialog-shape:0] [--forge-dialog-background:transparent] [&::part(surface)]:block"
      data-nav-dialog>
      <forge-scaffold
        class="h-full bg-linear-to-b from-(--forge-theme-primary-container-minimum)/75 to-(--forge-theme-primary-container)/75 backdrop-blur-xl">
        <forge-toolbar
          slot="header"
          no-divider
          class="[--forge-toolbar-background:transparent]">
          <forge-icon-button slot="end" aria-label="Close navigation" data-nav-close>
            <forge-icon name="close"></forge-icon>
          </forge-icon-button>
        </forge-toolbar>
        <div slot="body" class="h-full overflow-hidden" data-nav-dialog-body></div>
      </forge-scaffold>
    </forge-dialog>

    <SearchDialog />

    <FoundryChatbot />

    <style is:global>
      /* Forge card CSS variables — not representable as Tailwind utilities. */
      .body-card {
        --forge-card-shape: 12px;
        --forge-card-padding: var(--forge-spacing-large);
        --forge-card-overflow: hidden;
      }

      .body-card.flush {
        --forge-card-padding: 0;
      }
    </style>

    <style lang="scss">
      @use "@tylertech/forge/sass/typography" as forge-typography;

      // `<a>` appears throughout slotted/child content (sidenav, MDX,
      // breadcrumbs) rather than this component's own template, so :global()
      // is required — same escape hatch Blockquote.astro uses for its
      // slotted body content.
      :global(a) {
        @include forge-typography.anchor-base;

        &:visited {
          @include forge-typography.anchor-visited;
        }

        &:hover {
          @include forge-typography.anchor-hover;
        }

        &:active {
          @include forge-typography.anchor-active;
        }
      }
    </style>

    <style lang="scss">
      // Thin scrollbar styling (no Tailwind equivalent for ::-webkit-scrollbar).
      [data-scroll-body] {
        scrollbar-width: thin;

        // Bleed the scrollbar out into the card's padding instead of
        // rendering it flush against the padded content.
        margin-right: calc(-1 * var(--forge-spacing-large));
        padding-right: var(--forge-spacing-large);

        &[data-flush] {
          margin-right: 0;
          padding-right: 0;
        }

        &::-webkit-scrollbar {
          width: 4px;
        }

        &::-webkit-scrollbar-track {
          background: transparent;
        }

        &::-webkit-scrollbar-thumb {
          background-color: var(
            --forge-theme-outline-variant,
            rgba(0, 0, 0, 0.2)
          );
          border-radius: 2px;
        }
      }
    </style>
  </body>
</html>
