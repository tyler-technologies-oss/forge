<forge-app-bar slot="header" id="page-app-bar" title-text="<%= site.title %><%= title ? ` - ${title}` : null %>" href="/">
  <forge-icon name="forge_logo" slot="logo"></forge-icon>
  <forge-icon-button slot="end" id="radix-theme-button" aria-pressed="false">
    <forge-icon name="color_lens"></forge-icon>
    <span id="radix-theme-indicator" style="position: absolute; top: 8px; right: 8px; width: 10px; height: 10px; border-radius: 50%; border: 1px solid #fff; background: #d32f2f; pointer-events: none"></span>
  </forge-icon-button>
  <forge-tooltip slot="end" anchor="radix-theme-button" type="label" placement="left" id="radix-theme-tooltip">Radix theme: off (click to turn on)</forge-tooltip>
  <forge-icon-button slot="end" id="dark-theme-button">
    <forge-icon name="brightness_3"></forge-icon>
  </forge-icon-button>
  <forge-tooltip slot="end" anchor="dark-theme-button" type="label" placement="left">Toggle theme</forge-tooltip>
</forge-app-bar>
