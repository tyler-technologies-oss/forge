<section>
  <h3 class="forge-typography--heading2">Modifiers and keys</h3>
  <div>
    <forge-kbd shift keys="K"></forge-kbd>
  </div>
</section>

<section>
  <h3 class="forge-typography--heading2">Keys</h3>
  <div>
    <forge-kbd keys="j k"></forge-kbd>
  </div>
</section>

<section>
  <h3 class="forge-typography--heading2">Modifiers</h3>
  <div>
    <forge-kbd ctrl></forge-kbd>
    <forge-kbd shift></forge-kbd>
    <forge-kbd alt></forge-kbd>
    <forge-kbd meta></forge-kbd>
  </div>
</section>

<section>
  <h3 class="forge-typography--heading2">Arrow keys</h3>
  <forge-kbd keys="ArrowUp"></forge-kbd>
  <forge-kbd keys="ArrowDown"></forge-kbd>
  <forge-kbd keys="ArrowLeft"></forge-kbd>
  <forge-kbd keys="ArrowRight"></forge-kbd>
</section>

<section>
  <h3 class="forge-typography--heading2">Dense</h3>
  <forge-kbd meta keys="s" dense></forge-kbd>
</section>

<section>
  <h3 class="forge-typography--heading2">Themes</h3>
  <div>
    <h4 class="forge-typography--subheading1">Primary</h4>
    <forge-kbd meta keys="s" theme="primary"></forge-kbd>
  </div>
  <div>
    <h4 class="forge-typography--subheading1">Secondary</h4>
    <forge-kbd meta keys="s" theme="secondary"></forge-kbd>
  </div>
  <div>
    <h4 class="forge-typography--subheading1">Tertiary</h4>
    <forge-kbd meta keys="s" theme="tertiary"></forge-kbd>
  </div>
  <div>
    <h4 class="forge-typography--subheading1">Success</h4>
    <forge-kbd meta keys="s" theme="success"></forge-kbd>
  </div>
  <div>
    <h4 class="forge-typography--subheading1">Warning</h4>
    <forge-kbd meta keys="s" theme="warning"></forge-kbd>
  </div>
  <div>
    <h4 class="forge-typography--subheading1">Error</h4>
    <forge-kbd meta keys="s" theme="error"></forge-kbd>
  </div>
  <div>
    <h4 class="forge-typography--subheading1">Info</h4>
    <forge-kbd meta keys="s" theme="info"></forge-kbd>
  </div>
</section>

