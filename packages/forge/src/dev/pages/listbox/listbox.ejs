<div class="vert">
  <section>
    <h3 class="forge-typography--heading2">Basic</h3>
    <forge-listbox id="basic-single">
      <forge-option value="1">Option 1</forge-option>
      <forge-option value="2">Option 2</forge-option>
      <forge-option value="3">Option 3</forge-option>
    </forge-listbox>
  </section>

  <section>
    <h3 class="forge-typography--heading2">With Option Groups</h3>
    <forge-listbox id="grouped">
      <forge-option-group>
        <div slot="label">Fruits</div>
        <forge-option value="apple">Apple</forge-option>
        <forge-option value="banana">Banana</forge-option>
        <forge-option value="orange">Orange</forge-option>
      </forge-option-group>
      <forge-option-group>
        <div slot="label">Vegetables</div>
        <forge-option value="carrot">Carrot</forge-option>
        <forge-option value="lettuce">Lettuce</forge-option>
        <forge-option value="tomato">Tomato</forge-option>
      </forge-option-group>
    </forge-listbox>
  </section>

  <section>
    <h3 class="forge-typography--heading2">Leading Icons</h3>
    <forge-listbox>
      <forge-option value="home">
        <forge-icon name="home" external slot="start"></forge-icon>
        Home
      </forge-option>
      <forge-option value="settings">
        <forge-icon name="settings" external slot="start"></forge-icon>
        Settings
      </forge-option>
      <forge-option value="profile">
        <forge-icon name="person" external slot="start"></forge-icon>
        Profile
      </forge-option>
    </forge-listbox>
  </section>

  <section>
    <h3 class="forge-typography--heading2">Horizontal Orientation</h3>
    <forge-listbox id="horizontal" orientation="horizontal">
      <forge-option value="left">Left</forge-option>
      <forge-option value="center">Center</forge-option>
      <forge-option value="right">Right</forge-option>
    </forge-listbox>
  </section>

  <section>
    <h3 class="forge-typography--heading2">Two Line</h3>
    <forge-listbox>
      <forge-option value="1" two-line>
        <span>Option 1</span>
        <span slot="secondary">Secondary text for option 1</span>
      </forge-option>
      <forge-option value="2" two-line>
        <span>Option 2</span>
        <span slot="secondary">Secondary text for option 2</span>
      </forge-option>
      <forge-option value="3" two-line>
        <span>Option 3</span>
        <span slot="secondary">Secondary text for option 3</span>
      </forge-option>
    </forge-listbox>
  </section>

  <section>
    <h3 class="forge-typography--heading2">Three Line</h3>
    <forge-listbox>
      <forge-option value="1" three-line>
        <span>Option 1</span>
        <span slot="secondary">Secondary text for option 1</span>
        <span slot="tertiary">Tertiary text for option 1</span>
      </forge-option>
      <forge-option value="2" three-line>
        <span>Option 2</span>
        <span slot="secondary">Secondary text for option 2</span>
        <span slot="tertiary">Tertiary text for option 2</span>
      </forge-option>
      <forge-option value="3" three-line>
        <span>Option 3</span>
        <span slot="secondary">Secondary text for option 3</span>
        <span slot="tertiary">Tertiary text for option 3</span>
      </forge-option>
  </section>

  <section>
    <h3 class="forge-typography--heading2">Dual Listbox</h3>
    <div class="dual-listbox-container">
      <forge-card class="listbox-card">
        <forge-listbox id="dual-listbox-1" drag-out>
          <forge-option value="1">Option 1</forge-option>
          <forge-option value="2">Option 2</forge-option>
          <forge-option value="3">Option 3</forge-option>
        </forge-listbox>
      </forge-card>
      <forge-card class="listbox-card">
        <forge-listbox id="dual-listbox-2" drop-from="dual-listbox-1">
          <forge-option value="a">Option A</forge-option>
          <forge-option value="b">Option B</forge-option>
          <forge-option value="c">Option C</forge-option>
          <forge-option-group>
            <div slot="label">Group 1</div>
            <forge-option value="x">Option D</forge-option>
            <forge-option value="y">Option E</forge-option>
          </forge-option-group>
        </forge-listbox>
      </forge-card>
    </div>
  </section>
</div>

<script type="module" src="listbox.ts"></script>
