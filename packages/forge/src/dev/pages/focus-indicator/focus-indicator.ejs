<div class="vert">
  <!-- Default example with :focus-visible -->
  <div>
    <button type="button" class="example-target">
      Button :focus-visible
      <forge-focus-indicator></forge-focus-indicator>
    </button>
  </div>

  <!-- Default example with :focus-visible -->
  <div>
    <button type="button" class="example-target custom-target">
      Custom :focus-visible
      <forge-focus-indicator></forge-focus-indicator>
    </button>
  </div>

  <!-- Default example with :focus-visible and target -->
  <div>
    <div class="example-target">
      <button id="target-btn" type="button" class="example-target">
        Button :focus-visible w/target
      </button>
      <forge-focus-indicator target="target-btn"></forge-focus-indicator>
    </div>
  </div>

  <!-- Example with :focus -->
  <div>
    <button type="button" class="example-target">
      Button :focus
      <forge-focus-indicator allow-focus></forge-focus-indicator>
    </button>
  </div>

  <!-- Circular example-->
  <div>
    <div tabindex="0" role="button" class="example-target icon">
      <forge-icon name="forge_logo"></forge-icon>
      <forge-focus-indicator circular></forge-focus-indicator>
      <forge-state-layer></forge-state-layer>
    </div>
  </div>

  <!-- Typical card example -->
  <div tabindex="0" role="button" class="example-target">
    <forge-card role="presentation" style="border-radius: 4px;">
      <p style="margin: 0;">
        Lorem ipsum dolor, sit amet consectetur adipisicing elit. Voluptate, nihil et sequi similique ad,
        voluptas quod quisquam iure deleniti voluptatibus pariatur laborum maiores iste omnis ut sapiente!
        Repellendus, autem delectus.
      </p>
    </forge-card>
    <forge-focus-indicator style="--forge-focus-indicator-inward-offset: 1px; --forge-focus-indicator-shape: 4px;"></forge-focus-indicator>
    <forge-state-layer></forge-state-layer>
  </div>

  <!-- Inward example -->
  <div>
    <div class="example-target inward-example" tabindex="0" role="button">
      <span>Inward example</span>
      <forge-focus-indicator allow-focus inward></forge-focus-indicator>
      <forge-state-layer></forge-state-layer>
    </div>
  </div>


  <!-- Scrolled out of view: focus an item, then scroll it out of the container (FORGE-338) -->
  <section>
    <h2>Scroll containers</h2>
    <p>Tab to a button, then scroll it out of view. The indicator should hide with it.</p>
    <div class="scroll-demo scroll-demo--vertical" id="vertical-scroller">
      <button type="button" class="example-target">Vertical 1<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Vertical 2<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Vertical 3<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Vertical 4<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Vertical 5<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Vertical 6<forge-focus-indicator></forge-focus-indicator></button>
    </div>
    <div class="scroll-demo scroll-demo--horizontal" id="horizontal-scroller">
      <button type="button" class="example-target">Horizontal 1<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Horizontal 2<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Horizontal 3<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Horizontal 4<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Horizontal 5<forge-focus-indicator></forge-focus-indicator></button>
      <button type="button" class="example-target">Horizontal 6<forge-focus-indicator></forge-focus-indicator></button>
    </div>
  </section>

  <!-- Layout shift: the scrollbar appears and disappears and moves the field (FORGE-296) -->
  <section>
    <h2>Layout shift</h2>
    <p>Focus the field with the keyboard, then click the button. The button doesn't take focus, so the indicator stays active while the scrollbar appears and disappears and it should stay on the field.</p>
    <forge-button id="toggle-shift-content" variant="outlined">Toggle tall content</forge-button>
    <div class="shift-demo" id="shift-scroller">
      <div class="shift-demo__content">
        <forge-text-field show-clear>
          <label for="shift-input">Filter</label>
          <input id="shift-input" type="text" />
        </forge-text-field>
        <div class="shift-demo__spacer" id="shift-spacer"></div>
      </div>
    </div>
  </section>

  <!-- CSS-only example -->
  <button type="button" class="forge-focus-indicator forge-focus-indicator__target">Button CSS-only</button>
  <button type="button" class="forge-focus-indicator__target">
    Button CSS-only with sentinel element
    <div class="forge-focus-indicator"></div>
  </button>
</div>

<script type="module" src="focus-indicator.ts"></script>
