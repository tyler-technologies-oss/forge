{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "forge-rich-text-editor-angular": {
      "projectType": "library",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "tsconfig.build.prod.json"
            },
            "development": {
              "tsConfig": "tsconfig.build.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "forge-rich-text-editor-angular-demo:build:development",
            "browsers": ["chromiumHeadless"],
            "include": ["../test/**/*.spec.ts"]
          }
        }
      }
    },
    "forge-rich-text-editor-angular-demo": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src/dev",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist-demo"
            },
            "index": "src/dev/index.html",
            "browser": "src/dev/main.ts",
            "tsConfig": "src/dev/tsconfig.json",
            "polyfills": ["zone.js"],
            "conditions": ["module", "production"],
            "styles": ["node_modules/@tylertech/forge/dist/forge.css"]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            },
            "production": {
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 3462,
            "prebundle": false
          },
          "configurations": {
            "development": {
              "buildTarget": "forge-rich-text-editor-angular-demo:build:development"
            },
            "production": {
              "buildTarget": "forge-rich-text-editor-angular-demo:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
