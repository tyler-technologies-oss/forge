{
  "name": "@tylertech/forge-upgrade",
  "version": "2.5.0",
  "description": "Automated upgrade utility for the Tyler Forge™ based projects.",
  "main": "index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "forge-upgrade": "index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tyler",
    "forge",
    "upgrade",
    "migration"
  ],
  "author": "Tyler Technologies, Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-technologies-oss/forge.git",
    "directory": "packages/forge-upgrade"
  },
  "scripts": {
    "lint": "eslint",
    "test": "vitest run",
    "vitest": "vitest",
    "format": "prettier --write \"**/*.{mjs,cjs,js,json}\"",
    "format:check": "prettier --check \"**/*.{mjs,cjs,js,json}\""
  },
  "files": [
    "configurations/**/*",
    "migrations/**/*",
    "index.mjs",
    "log.mjs",
    "migration-utils.mjs"
  ],
  "dependencies": {
    "canonical-path": "^1.0.0",
    "chalk": "^5.3.0",
    "glob": "^11.0.0",
    "jscodeshift": "^17.0.0",
    "ora": "^8.1.0",
    "posthtml": "^0.16.6",
    "posthtml-attrs-parser": "^1.1.1",
    "posthtml-match-helper": "^2.0.2",
    "replace-in-file": "^8.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "catalog:",
    "globals": "^16.0.0",
    "prettier": "catalog:",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
