{
  "name": "@tylertech/forge-react",
  "version": "3.4.0",
  "description": "The official Tyler Forge™ components adapter library for React.",
  "author": "Tyler Technologies, Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-technologies-oss/forge.git",
    "directory": "packages/forge-react"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "dev": "vite src/dev",
    "lint": "eslint",
    "test": "vitest run --browser.headless",
    "vitest": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\""
  },
  "dependencies": {
    "reactify-wc": "^4.0.0",
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "@tylertech/forge": "^3.15.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@tylertech/forge": "workspace:*",
    "@tylertech-eslint/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^17.0.91",
    "@types/react-dom": "^17.0.26",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.4",
    "rimraf": "catalog:",
    "sass": "catalog:",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "publishConfig": {
    "access": "public"
  }
}
