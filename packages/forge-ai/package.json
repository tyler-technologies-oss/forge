{
  "name": "@tylertech/forge-ai",
  "version": "0.15.2",
  "description": "A library of Tyler Forge™ AI chat interface web components.",
  "license": "Apache-2.0",
  "author": "Tyler Technologies, Inc.",
  "keywords": [
    "tyler forge",
    "web components",
    "custom elements",
    "lit",
    "ai",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-technologies-oss/forge.git",
    "directory": "packages/forge-ai"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.mjs"
    },
    "./custom-elements.json": {
      "default": "./custom-elements.json"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist/",
    "custom-elements.json",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "rimraf dist && vite build && pnpm cem",
    "cem": "cem analyze --config custom-elements-manifest.config.mjs --litelement",
    "lint": "tsc --noEmit && eslint . && stylelint \"src/lib/**/*.{css,scss}\" --allow-empty-input",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --browser.headless",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,js,mjs,md,mdx,css,scss,yaml,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,md,mdx,css,scss,yaml,json}\"",
    "plop": "plop"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lit/context": "catalog:",
    "dompurify": "^3.4.13",
    "lit": "catalog:",
    "marked": "^18.0.7",
    "remend": "^1.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@tylertech-eslint/eslint-plugin": "catalog:",
    "@tylertech/forge": "workspace:*",
    "@tylertech/forge-tokens": "workspace:*",
    "@tylertech/stylelint-rules": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@wc-toolkit/jsdoc-tags": "^1.2.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "glob": "catalog:",
    "plop": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "sass": "catalog:",
    "stylelint": "catalog:",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2",
    "vitest-browser-lit": "^1.0.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "publishConfig": {
    "access": "public"
  }
}
